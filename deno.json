{
  "imports": {
    "sql-formatter": "npm:sql-formatter@15",
    "@std/fs": "jsr:@std/fs@1"
  },
  "fmt": {
    "proseWrap": "preserve",
    "exclude": ["worker/"]
  },
  "lint": {
    "exclude": ["worker/"]
  },
  "tasks": {
    "poller": "deno run --allow-net --allow-env poller/main.ts",
    "processor": "deno run --allow-net --allow-env processor/main.ts",
    "lint": "deno lint && deno fmt --check",
    "fix": "deno fmt && deno lint --fix",
    "fmt:sql": "deno run -A scripts/fmt-sql.ts worker/migrations/*.sql",
    "fmt:sql:check": "deno run -A scripts/fmt-sql.ts --check worker/migrations/*.sql"
  }
}
